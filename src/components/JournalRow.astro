---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime, tagLabel } from '../lib/format';
import { url } from '../lib/url';
import { IMAGE_QUALITY, IMAGE_WIDTHS } from '../lib/images';

interface Props {
  post: CollectionEntry<'journal'>;
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;
---

<a class="journal-row" href={url(`/journal/${post.id}/`)}>
  <span class="journal-thumb" aria-hidden="true">
    <Image
      src={heroImage}
      alt=""
      widths={IMAGE_WIDTHS}
      sizes="(max-width: 760px) 100vw, 11rem"
      format="webp"
      quality={IMAGE_QUALITY}
      loading="lazy"
    />
  </span>

  <span class="journal-body">
    <h2>{title}</h2>
    <p>{description}</p>
    <span class="journal-meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span>{readingTime(post.body)} min read</span>
      <span>{tags.slice(0, 2).map(tagLabel).join(' / ')}</span>
    </span>
  </span>

  <span class="journal-side" aria-hidden="true">
    <span>{tagLabel(tags[0] ?? 'Field note')}</span>
    <span class="arrow">↗</span>
  </span>
</a>
