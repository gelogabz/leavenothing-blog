---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, tagLabel, tagSlug } from '../lib/format';
import { url } from '../lib/url';

interface Props {
  post: CollectionEntry<'journal'>;
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage, heroAlt, tags } = post.data;
---

<article class="post-card" data-reveal>
  <a class="post-card-media" href={url(`/journal/${post.id}/`)} tabindex="-1" aria-hidden="true">
    <Image
      src={heroImage}
      alt={heroAlt}
      widths={[400, 640, 900]}
      sizes="(max-width: 760px) 100vw, (max-width: 980px) 50vw, 33vw"
      format="webp"
      quality={82}
      loading="lazy"
    />
  </a>

  <div class="post-card-meta">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    {tags.slice(0, 1).map((tag) => <span>{tagLabel(tag)}</span>)}
  </div>

  <h3><a href={url(`/journal/${post.id}/`)}>{title}</a></h3>
  <p>{description}</p>

  <ul class="tag-row" aria-label="Topics">
    {
      tags.slice(0, 3).map((tag) => (
        <li>
          <a class="tag" href={url(`/tags/${tagSlug(tag)}/`)}>
            {tagLabel(tag)}
          </a>
        </li>
      ))
    }
  </ul>
</article>
