---
import { NAV } from '../consts';
import { stripBase, url } from '../lib/url';

const current = stripBase(Astro.url.pathname);
const isActive = (href: string) => {
  if (href === '/') return current === '/';
  return current === href || current.startsWith(href.replace(/\/$/, ''));
};
---

<header class="site-header" data-header>
  <div class="shell header-inner">
    <a class="brand" href={url('/')} aria-label="LeaveNothing — home">
      <svg
        class="brand-mark"
        viewBox="0 0 32 32"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <rect width="32" height="32" rx="6" fill="currentColor" />
        <path
          d="M6 22.5c3.8-4.7 6.6-1.9 9.6-5.9 2.8-3.7 5-6.9 9.4-4.8"
          stroke="var(--bg)"
          stroke-width="1.4"
          stroke-linecap="round"
        />
        <path
          d="M7.5 26c3.5-4 6.5-2 9.2-5.4 2.5-3.1 4.4-5.4 8.3-3.8"
          stroke="var(--bg)"
          stroke-width="1.4"
          stroke-linecap="round"
          opacity=".62"
        />
        <circle cx="23.5" cy="9.5" r="1.8" fill="var(--accent)" />
      </svg>
      <span>LeaveNothing<span class="brand-dot">.</span></span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main navigation" data-nav>
      {NAV.map((item) => (
        <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button
        class="icon-btn theme-toggle"
        type="button"
        aria-label="Switch to dark theme"
        title="Switch theme"
        data-theme-toggle
      >
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41" stroke-linecap="round" />
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round" />
        </svg>
      </button>

      <button
        class="icon-btn nav-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="site-nav"
        data-nav-toggle
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const navToggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  const setThemeLabel = () => {
    if (!themeToggle) return;
    const dark = root.dataset.theme === 'dark';
    themeToggle.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
  };

  setThemeLabel();

  themeToggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    // The theme still applies for this page if storage is blocked.
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* persisting the choice is best-effort */
    }
    setThemeLabel();
  });

  const setMenu = (open: boolean) => {
    if (!nav || !navToggle) return;
    nav.dataset.open = String(open);
    navToggle.setAttribute('aria-expanded', String(open));
    navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.dataset.menuOpen = String(open);
  };

  navToggle?.addEventListener('click', () => {
    setMenu(nav?.dataset.open !== 'true');
  });

  nav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setMenu(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });

  const desktop = window.matchMedia('(min-width: 761px)');
  desktop.addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
  });
</script>
