---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page not found" description="That page is not here." noindex>
  <section class="not-found shell">
    <div>
      <p class="eyebrow">404</p>
      <h1>Off the trail.</h1>
      <p>
        This page does not exist, or it moved. The journal, the photography archive, and the
        topics list are all still where you left them.
      </p>
      <div class="hero-actions">
        <a class="btn" href={url('/')}>Back home</a>
        <a class="btn btn--ghost" href={url('/blog/')}>Read the journal</a>
      </div>
    </div>
  </section>
</BaseLayout>
