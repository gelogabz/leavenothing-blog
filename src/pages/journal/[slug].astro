---
import { render } from 'astro:content';
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { formatLongDate, readingTime, tagLabel, tagSlug } from '../../lib/format';
import { getPublishedPosts } from '../../lib/posts';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Oldest first: the neighbours read as before/after in publication order.
const posts = await getPublishedPosts({ order: 'oldest-first' });

const position = posts.findIndex((item) => item.id === post.id);
const previous = position > 0 ? posts[position - 1] : undefined;
const next = position < posts.length - 1 ? posts[position + 1] : undefined;

const related = posts
  .filter(
    (item) =>
      item.id !== post.id && item.data.tags.some((tag) => post.data.tags.includes(tag))
  )
  .slice(0, 3);

const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const minutes = readingTime(post.body);
const heroUrl = new URL(post.data.heroImage.src, Astro.site ?? Astro.url).href;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={heroUrl}
  type="article"
  publishedTime={post.data.pubDate}
  updatedTime={post.data.updatedDate}
  tags={post.data.tags}
>
  <article>
    <header class="post-head">
      <div class="shell">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href={url('/')}>Home</a>
          <span aria-hidden="true">/</span>
          <a href={url('/journal/')}>Journal</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{tagLabel(post.data.tags[0] ?? 'Field note')}</span>
        </nav>

        <h1>{post.data.title}</h1>
        <p class="post-deck">{post.data.description}</p>

        <div class="post-meta">
          <span>{post.data.author}</span>
          <time datetime={post.data.pubDate.toISOString()}>
            {formatLongDate(post.data.pubDate)}
          </time>
          <span>{minutes} min read</span>
          {post.data.updatedDate && <span>Updated {formatLongDate(post.data.updatedDate)}</span>}
        </div>
      </div>
    </header>

    <figure class="post-hero">
      <div class="post-hero-image">
        <Image
          src={post.data.heroImage}
          alt={post.data.heroAlt}
          widths={[800, 1200, 1600, 2000]}
          sizes="(max-width: 1200px) 100vw, 92rem"
          format="webp"
          quality={84}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>
        <span>{post.data.heroAlt}</span>
        <span>Photograph — Gelo Baring</span>
      </figcaption>
    </figure>

    <div class="shell post-body">
      {
        toc.length > 1 && (
          <aside class="post-aside" aria-label="On this page">
            <h2>On this page</h2>
            <ol>
              {toc.map((heading) => (
                <li class={heading.depth === 3 ? 'toc-level-3' : undefined}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }

      <div class="prose">
        <Content />
      </div>

      {
        post.data.gallery.length > 0 && (
          <div class="post-gallery">
            {post.data.gallery.map((image, i) => (
              <figure class={i === 0 ? 'post-gallery-wide' : undefined}>
                <Image
                  src={image.src}
                  alt={image.alt}
                  widths={[480, 720, 960, 1280]}
                  sizes={i === 0 ? '(max-width: 980px) 100vw, 46rem' : '(max-width: 760px) 100vw, 22rem'}
                  format="webp"
                  quality={82}
                  loading="lazy"
                />
                {image.caption && <figcaption>{image.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )
      }

      <footer class="post-end">
        <ul class="tag-row" aria-label="Topics">
          {
            post.data.tags.map((tag) => (
              <li>
                <a class="tag" href={url(`/tags/${tagSlug(tag)}/`)}>
                  {tagLabel(tag)}
                </a>
              </li>
            ))
          }
        </ul>

        <nav class="post-nav" aria-label="More essays">
          {
            previous ? (
              <a href={url(`/journal/${previous.id}/`)}>
                <span>Previous</span>
                <strong>{previous.data.title}</strong>
              </a>
            ) : (
              <a href={url('/journal/')}>
                <span>Back to</span>
                <strong>All essays</strong>
              </a>
            )
          }
          {
            next ? (
              <a class="next" href={url(`/journal/${next.id}/`)}>
                <span>Next</span>
                <strong>{next.data.title}</strong>
              </a>
            ) : (
              <a class="next" href={url('/photography/')}>
                <span>Elsewhere</span>
                <strong>The photography archive</strong>
              </a>
            )
          }
        </nav>
      </footer>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <div class="shell">
          <div class="section-head">
            <div>
              <h2 id="related-title">Related notes</h2>
            </div>
            <a class="link-arrow section-link" href={url('/journal/')}>
              All essays
            </a>
          </div>
          <div class="post-grid">
            {related.map((item) => (
              <PostCard post={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
