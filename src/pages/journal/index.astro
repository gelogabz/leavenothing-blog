---
import { Image } from 'astro:assets';

import BaseLayout from '../../layouts/BaseLayout.astro';
import JournalRow from '../../components/JournalRow.astro';
import FeaturedEssay from '../../components/FeaturedEssay.astro';
import { getPublishedPosts } from '../../lib/posts';
import { getPhoto } from '../../data/photos';
import { url } from '../../lib/url';

const posts = await getPublishedPosts();
const [lead, ...rest] = posts;
const archivePhoto = getPhoto('01-sea-of-clouds.jpg');
---

<BaseLayout
  title="Journal"
  description="Essays and field notes on Philippine forests, coasts, wildlife, and the people looking after them."
>
  <header class="page-head">
    <div class="shell page-head-inner">
      <div>
        <h1>Notes from outside.</h1>
      </div>
      <p class="page-deck">
        Long-form essays about the places, species, and people of the Philippines — written
        slowly, photographed carefully.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      {
        lead ? (
          <FeaturedEssay
            post={lead}
            eyebrow="Most recent"
            meta="Essay"
            cta="Read the essay"
          />
        ) : (
          <p class="muted">The first essay is still being written.</p>
        )
      }
    </div>
  </section>

  {
    rest.length > 0 && (
      <section class="section" aria-labelledby="archive-title">
        <div class="shell">
          <div class="section-head">
            <div>
              <h2 id="archive-title">Everything else</h2>
            </div>
            <a class="link-arrow section-link" href={url('/rss.xml')}>
              RSS
            </a>
          </div>

          <div class="journal-list">
            {rest.map((post) => (
              <JournalRow post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="shell split">
      <div class="split-body">
        <h2>Forests, coasts, climate, people.</h2>
        <p>
          The journal is organised by the systems it tries to describe, not by chronology.
          Start with whichever thread you already care about.
        </p>
        <a class="btn btn--ghost" href={url('/topics/')}>All topics</a>
      </div>
      <div class="split-media">
        <Image
          src={archivePhoto.src}
          alt={archivePhoto.alt}
          widths={[480, 720, 960]}
          sizes="(max-width: 980px) 100vw, 45vw"
          format="webp"
          quality={82}
          loading="lazy"
        />
      </div>
    </div>
  </section>
</BaseLayout>
