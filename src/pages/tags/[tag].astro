---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { tagLabel, tagSlug } from '../../lib/format';
import { getPublishedPosts } from '../../lib/posts';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
const label = tagLabel(tag);
---

<BaseLayout
  title={`${label} — Journal`}
  description={`Essays and field notes filed under ${label.toLowerCase()} on LeaveNothing.`}
>
  <header class="page-head">
    <div class="shell page-head-inner">
      <div>
        <p class="eyebrow">Topic</p>
        <h1>{label}</h1>
      </div>
      <p class="page-deck">
        {posts.length} {posts.length === 1 ? 'essay' : 'essays'} filed under this subject.
        <a href={url('/topics/')}> See all topics.</a>
      </p>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <div class="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>
