---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, CONTACT_ENDPOINT } from '../consts';
---

<BaseLayout
  title="Contact"
  description="Get in touch about editorial work, photography licensing, corrections, or a source worth adding."
>
  <header class="page-head">
    <div class="shell page-head-inner">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Say hello.</h1>
      </div>
      <p class="page-deck">
        Corrections, story tips, licensing enquiries, or a source I should be reading. I read
        everything and reply to most of it.
      </p>
    </div>
  </header>

  <section class="shell contact-grid">
    <div class="contact-aside" data-reveal>
      <h2>Direct</h2>
      <p>
        Email is the most reliable route. I am not on social media much, and I do not answer
        cold pitches for guest posts or link insertions.
      </p>
      <a class="contact-email" href={`mailto:${SITE.email}`}>{SITE.email}</a>

      <h2>What I reply to</h2>
      <p>
        Corrections and factual challenges. Local sources and community projects. Editorial
        commissions that involve actual reporting. Photography licensing with a stated use.
      </p>

      <h2>What I don't</h2>
      <p>
        SEO guest posts, sponsored links, AI content swaps, and anything that requires me to
        call a place "untouched".
      </p>
    </div>

    <form
      class="contact-form"
      method="post"
      action={CONTACT_ENDPOINT || `mailto:${SITE.email}`}
      enctype={CONTACT_ENDPOINT ? undefined : 'text/plain'}
      data-contact-form
      data-endpoint={CONTACT_ENDPOINT}
      data-email={SITE.email}
    >
      <fieldset>
        <legend>Your details</legend>
        <div class="field">
          <label for="contact-name">Name</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="contact-email">Email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
        </div>
      </fieldset>

      <div class="field">
        <label for="contact-subject">Subject</label>
        <select id="contact-subject" name="subject">
          <option>General enquiry</option>
          <option>Correction</option>
          <option>Story tip or source</option>
          <option>Photography licensing</option>
          <option>Editorial commission</option>
        </select>
      </div>

      <div class="field">
        <label for="contact-message">Message</label>
        <textarea
          id="contact-message"
          name="message"
          rows="7"
          placeholder="Where the place is, what you noticed, and why it matters."
          required
        ></textarea>
      </div>

      <p class="field-note">
        {
          CONTACT_ENDPOINT
            ? 'Your message goes to a form relay. No tracking pixels, no newsletter signup.'
            : `This prototype opens your mail app. If that fails, write to ${SITE.email} directly.`
        }
      </p>

      <div>
        <button class="btn" type="submit">Send message</button>
      </div>

      <p class="form-status" role="status" aria-live="polite" data-form-status></p>
    </form>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  form?.addEventListener('submit', (event) => {
    // A real endpoint is configured: let the browser POST normally.
    if (form.dataset.endpoint) return;

    event.preventDefault();

    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const subject = String(data.get('subject') ?? 'Website enquiry').trim();
    const message = String(data.get('message') ?? '').trim();

    const body = [`Name: ${name}`, `Email: ${email}`, '', message].join('\n');
    const mailto = `mailto:${form.dataset.email}?subject=${encodeURIComponent(
      subject
    )}&body=${encodeURIComponent(body)}`;

    if (status) status.textContent = 'Opening your mail app…';
    window.location.href = mailto;
  });
</script>
